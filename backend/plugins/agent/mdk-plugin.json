{
  "name": "@tetherto/mdk-plugin-agent",
  "version": "0.7.0",
  "description": "Auth-gated chat API over the MDK operator agent: sessions, SSE message streams, and approval round-trips for write tools.",
  "setup": [
    {
      "key": "agent.provider",
      "prompt": "Agent model provider (JSON; point baseURL at a running OpenAI-compatible endpoint, e.g. `npx qvac serve openai` — edit or Enter to accept)",
      "type": "json",
      "default": "{\"kind\":\"qvac\",\"model\":\"qwen3-4b\",\"baseURL\":\"http://127.0.0.1:11500/v1\"}"
    },
    {
      "key": "agent.mcp",
      "prompt": "MCP tool server the agent calls fleet tools through (JSON; edit or Enter to accept)",
      "type": "json",
      "default": "{\"url\":\"http://127.0.0.1:3008/mcp\"}"
    },
    {
      "key": "agent.approvalTimeoutMs",
      "prompt": "Approval timeout for write tools (ms)",
      "type": "json",
      "default": "120000"
    }
  ],
  "routes": [
    {
      "id": "agent.session.create",
      "method": "POST",
      "path": "/agent/sessions",
      "handler": "./controllers/sessions.js",
      "auth": true,
      "errors": [
        "ERR_AUTH_PERM_DENIED",
        "ERR_AGENT_UNAVAILABLE"
      ]
    },
    {
      "id": "agent.session.message",
      "method": "POST",
      "path": "/agent/sessions/:id/messages",
      "handler": "./controllers/messages.js",
      "auth": true,
      "stream": true,
      "errors": [
        "ERR_AUTH_PERM_DENIED",
        "ERR_AGENT_SESSION_NOT_FOUND",
        "ERR_AGENT_TURN_ACTIVE",
        "ERR_AGENT_MESSAGE_TEXT_REQUIRED",
        "ERR_AGENT_UNAVAILABLE"
      ],
      "constraints": [
        "Responds as text/event-stream; events carry the gateway wire envelope (turnId, seq, approvalId on pending_approval)."
      ]
    },
    {
      "id": "agent.approval.decide",
      "method": "POST",
      "path": "/agent/sessions/:id/approvals/:approvalId",
      "handler": "./controllers/approvals.js",
      "auth": true,
      "errors": [
        "ERR_AUTH_PERM_DENIED",
        "ERR_AGENT_SESSION_NOT_FOUND",
        "ERR_AGENT_APPROVAL_NOT_FOUND"
      ]
    },
    {
      "id": "agent.session.delete",
      "method": "DELETE",
      "path": "/agent/sessions/:id",
      "handler": "./controllers/sessions.js#remove",
      "auth": true,
      "errors": [
        "ERR_AUTH_PERM_DENIED",
        "ERR_AGENT_SESSION_NOT_FOUND",
        "ERR_AGENT_TURN_ACTIVE"
      ]
    }
  ]
}
