{
  "name": "@tetherto/mdk-worker-spiderpool",
  "version": "0.7.0",
  "description": "SpiderPool miner pool lib",
  "keywords": [
    "tether"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "type": "commonjs",
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "mock": "node mock/server.js",
    "test": "npm run lint && npm run test:unit && npm run test:integration",
    "test:unit": "NODE_ENV=test brittle tests/unit/**/*.test.js",
    "test:integration": "NODE_ENV=test brittle tests/integration/**/*.test.js",
    "test:coverage": "NODE_ENV=test brittle --coverage 'tests/**/*.test.js'"
  },
  "dependencies": {
    "@bitfinex/lib-js-util-base": "git+https://github.com/bitfinexcom/lib-js-util-base.git",
    "@tetherto/hp-svc-facs-store": "git+https://github.com/tetherto/hp-svc-facs-store.git#v1.0.0"
  },
  "devDependencies": {
    "brittle": "3.16.3",
    "date-fns": "3.6.0",
    "fastify": "5.8.5",
    "standard": "17.1.2",
    "yargs": "17.7.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
