{
  "name": "@tetherto/mdk-agent",
  "version": "0.7.0",
  "description": "MDK operator agent — headless loop over a local (QVAC) model, consuming MDK tools via MCP.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "index.js",
  "bin": {
    "mdk-agent": "./bin/mdk-agent.js",
    "qvac-cache-reaper": "./bin/qvac-cache-reaper.js"
  },
  "scripts": {
    "start": "node bin/mdk-agent.js",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "npm run lint && npm run test:unit && npm run test:integration",
    "test:unit": "NODE_ENV=test brittle tests/unit/*.js",
    "test:integration": "NODE_ENV=test brittle tests/integration/*.test.js"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@qvac/ai-sdk-provider": "^0.3.0",
    "ai": "^6.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "brittle": "3.18.0",
    "standard": "17.1.0"
  },
  "peerDependencies": {
    "@qvac/cli": "^0.9.0"
  },
  "peerDependenciesMeta": {
    "@qvac/cli": {
      "optional": true
    }
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "@hono/node-server": "2.0.12",
    "undici": ">=6.24.0"
  },
  "author": "Tether",
  "license": "Apache-2.0"
}
