{
  "name": "@tetherto/mdk-gateway",
  "version": "0.7.0",
  "description": "MDK Gateway",
  "keywords": [
    "tether"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./plugin": "./plugin.js",
    "./workers/lib/plugin-loader": "./workers/lib/plugin-loader.js",
    "./workers/lib/plugin-gateway": "./workers/lib/plugin-gateway.js"
  },
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "npm run lint && npm run test:unit && npm run test:integration",
    "test:unit": "NODE_ENV=test brittle tests/unit/**/*.test.js",
    "test:integration": "NODE_ENV=test npx brittle tests/integration/*.test.js",
    "test:api": "NODE_ENV=test npx brittle tests/integration/api.test.js",
    "test:watch": "brittle tests/unit/**/*.js --watch",
    "test:coverage": "NODE_ENV=test brittle --coverage 'tests/**/*.test.js'",
    "dev": "node worker.js --wtype wrk-node-http --env development --port 3000",
    "start": "node worker.js --wtype wrk-node-http --env production --port 3000"
  },
  "dependencies": {
    "@bitfinex/bfx-facs-lru": "git+https://github.com/bitfinexcom/bfx-facs-lru.git",
    "@bitfinex/bfx-svc-boot-js": "1.2.0",
    "@tetherto/mdk-mcp": "^0.7.0",
    "@tetherto/mdk-plugins": "^0.7.0",
    "@tetherto/mdk-worker": "^0.7.0",
    "@tetherto/svc-facs-httpd": "git+https://github.com/tetherto/svc-facs-httpd.git#v2.0.0",
    "@tetherto/tether-wrk-base": "git+https://github.com/tetherto/tether-wrk-base.git#v1.0.0",
    "async": "3.2.6",
    "debug": "4.4.1"
  },
  "devDependencies": {
    "brittle": "3.18.0",
    "http-server": "14.1.1",
    "standard": "17.1.0",
    "tether-svc-test-helper": "git+https://github.com/tetherto/tether-svc-test-helper.git"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "@tootallnate/once": "3.0.1",
    "tar": ">=7.5.4",
    "fastify": "5.10.0",
    "@fastify/static": "10.1.2",
    "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
    "fast-uri@>=4.0.0 <4.1.2": "4.1.2"
  }
}
