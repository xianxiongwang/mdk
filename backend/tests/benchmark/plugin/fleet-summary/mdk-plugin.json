{
  "name": "@tetherto/mdk-benchmark-plugin-fleet-summary",
  "version": "0.6.0",
  "description": "Benchmark harness Gateway plugin: aggregates hashrate and power across every registered device via the MDK protocol client. Device-family agnostic — reads only hashrate_avg/power, fields every worker type in this harness's WORKER_REGISTRY exposes.",
  "routes": [
    {
      "id": "fleet.summary",
      "handler": "./controllers/fleet-summary.js",
      "auth": true,
      "http": {
        "method": "GET",
        "path": "/api/fleet/summary",
        "responses": {
          "200": {
            "description": "Fleet totals with per-device breakdown.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deviceCount": { "type": "integer" },
                    "totalHashrateThs": { "type": "number" },
                    "totalPowerW": { "type": "number" },
                    "devices": { "type": "array" }
                  }
                }
              }
            }
          },
          "400": { "description": "MDK client unavailable." }
        }
      },
      "description": "Fans out telemetry.pull to every registered deviceId and returns fleet totals (total hashrate, total power, device count). Aggregation lives here — workers only ever answer for one device.",
      "constraints": [
        "Requires the MDK client to be connected to a Kernel instance.",
        "Devices must expose hashrate_avg and power telemetry channels."
      ],
      "examples": [
        {
          "description": "Get current fleet totals",
          "request": "GET /api/fleet/summary",
          "response": {
            "deviceCount": 2,
            "totalHashrateThs": 240,
            "totalPowerW": 6200,
            "devices": [{ "deviceId": "BENCH-0-00001", "hashrateThs": 100, "powerW": 3000 }]
          }
        }
      ],
      "errors": ["ERR_MDK_CLIENT_UNAVAILABLE"],
      "safety": "read-only"
    },
    {
      "id": "fleet.device.telemetry",
      "handler": "./controllers/device-telemetry.js",
      "auth": true,
      "http": {
        "method": "GET",
        "path": "/api/fleet/device/{id}/telemetry",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Single device's metrics telemetry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deviceId": { "type": "string" },
                    "metrics": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": { "description": "MDK client unavailable." }
        }
      },
      "description": "Single-device telemetry.pull through the Gateway (Gateway → Kernel → Worker → Gateway) — lets the benchmark harness time one device's read in isolation instead of only the fleet-wide aggregate.",
      "constraints": ["Requires the MDK client to be connected to a Kernel instance."],
      "examples": [
        {
          "description": "Read one device's metrics",
          "request": "GET /api/fleet/device/BENCH-0-00001/telemetry",
          "response": { "deviceId": "BENCH-0-00001", "metrics": { "hashrate_avg": 100, "power": 3000 } }
        }
      ],
      "errors": ["ERR_MDK_CLIENT_UNAVAILABLE"],
      "safety": "read-only"
    },
    {
      "id": "fleet.device.action",
      "handler": "./controllers/device-action.js",
      "auth": true,
      "http": {
        "method": "POST",
        "path": "/api/fleet/device/{id}/action",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": { "type": "string" },
                  "params": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Command accepted by the Kernel.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deviceId": { "type": "string" },
                    "action": { "type": "string" },
                    "result": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": { "description": "MDK client unavailable, or action missing from the request body." }
        }
      },
      "description": "Single-device write/action submit through the Gateway (Client → Gateway → Kernel accept), mirroring mdkClient.sendCommand but reachable over HTTP — lets the benchmark harness measure the write path with the Gateway in the loop.",
      "constraints": [
        "Requires the MDK client to be connected to a Kernel instance.",
        "The target action must be whitelisted by the owning Worker."
      ],
      "examples": [
        {
          "description": "Submit a setPowerMode action",
          "request": "POST /api/fleet/device/BENCH-0-00001/action { \"action\": \"setPowerMode\", \"params\": { \"mode\": \"normal\" } }",
          "response": { "deviceId": "BENCH-0-00001", "action": "setPowerMode", "result": { "accepted": true } }
        }
      ],
      "errors": ["ERR_MDK_CLIENT_UNAVAILABLE", "ERR_ACTION_REQUIRED"],
      "safety": "write"
    },
    {
      "id": "fleet.device.alerts",
      "handler": "./controllers/device-alerts.js",
      "auth": true,
      "http": {
        "method": "GET",
        "path": "/api/fleet/device/{id}/alerts",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Single device's currently active alerts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deviceId": { "type": "string" },
                    "alerts": { "type": "array" }
                  }
                }
              }
            }
          },
          "400": { "description": "MDK client unavailable." }
        }
      },
      "description": "Single-device alerts read through the Gateway (Consumer → Gateway → Kernel → alert source) — lets the benchmark harness measure the alerts path with the Gateway in the loop, not just the direct-to-Kernel path pollAlerts exercises.",
      "constraints": ["Requires the MDK client to be connected to a Kernel instance."],
      "examples": [
        {
          "description": "Read one device's active alerts",
          "request": "GET /api/fleet/device/BENCH-0-00001/alerts",
          "response": { "deviceId": "BENCH-0-00001", "alerts": [{ "name": "pcb_temp_warning", "severity": "medium" }] }
        }
      ],
      "errors": ["ERR_MDK_CLIENT_UNAVAILABLE"],
      "safety": "read-only"
    }
  ]
}
